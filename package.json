{
  "name": "sitebook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:delete": "node --experimental-strip-types --test scripts/check-delete.mts",
    "check:image": "node --experimental-strip-types --test scripts/check-image-path.mts",
    "check:patch": "node --experimental-strip-types --test scripts/check-patch-auth.mts",
    "classify:pending": "node scripts/classify-pending.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
